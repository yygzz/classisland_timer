<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuickTimerPlugin.Views.TimerOverlayWindow"
        Title="QuickTimer 选时" Width="400" Height="180"
        SystemDecorations="None" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" CanResize="False" IsHitTestVisible="False"
        TransparencyLevelHint="Transparent" Background="Transparent">
    <Border CornerRadius="12" Background="#F0202030" BorderBrush="#60FFFFFF" BorderThickness="1"
            Padding="16,10" BoxShadow="0 8 24 0 #66000000">
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border x:Name="ChipShort" CornerRadius="10" Padding="12,3" Background="#2EFFFFFF">
                    <TextBlock x:Name="ChipShortText" Text="短" FontSize="13" Foreground="#CCFFFFFF"/>
                </Border>
                <Border x:Name="ChipMedium" CornerRadius="10" Padding="12,3" Background="#2EFFFFFF">
                    <TextBlock x:Name="ChipMediumText" Text="中" FontSize="13" Foreground="#CCFFFFFF"/>
                </Border>
                <Border x:Name="ChipLong" CornerRadius="10" Padding="12,3" Background="#2EFFFFFF">
                    <TextBlock x:Name="ChipLongText" Text="长" FontSize="13" Foreground="#CCFFFFFF"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="PreviewText" Text="拖动选择时长" FontSize="42" FontWeight="Bold"
                       Foreground="#FFFFFFFF"/>
            <Canvas x:Name="TrackCanvas" Height="20"/>
            <TextBlock Text="拖回原点松开取消 · 松手开始计时" FontSize="11" Foreground="#99FFFFFF"/>
        </StackPanel>
    </Border>
</Window>
